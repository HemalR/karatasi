#!/bin/bash
# Wire Karatasi into an Omarchy Hyprland config: load the packaged bindings and window rules from
# ~/.config/hypr/hyprland.lua, reload Hyprland and start the background instance.
# `karatasi-setup --remove` takes the line out again.
set -euo pipefail

CONF="$HOME/.config/hypr/hyprland.lua"
LINE='dofile("/usr/share/karatasi/hypr/karatasi.lua")'

if [[ ! -f "$CONF" ]]; then
  echo "karatasi-setup: $CONF not found; is this an Omarchy system?" >&2
  exit 1
fi

if [[ "${1:-}" == "--remove" ]]; then
  if grep -qF "$LINE" "$CONF"; then
    cp "$CONF" "$CONF.bak.karatasi-$(date +%Y%m%d-%H%M%S)"
    grep -vF "$LINE" "$CONF" | grep -vF -- '-- Karatasi notes' >"$CONF.tmp" && mv "$CONF.tmp" "$CONF"
    echo "removed Karatasi from $CONF"
  fi
  pkill -x karatasi || true
  hyprctl reload >/dev/null
  exit 0
fi

if grep -qF "$LINE" "$CONF"; then
  echo "Karatasi is already loaded from $CONF"
else
  cp "$CONF" "$CONF.bak.karatasi-$(date +%Y%m%d-%H%M%S)"
  printf '\n-- Karatasi notes: Super+N toggles the floating notes window (karatasi-setup --remove undoes this).\n%s\n' "$LINE" >>"$CONF"
  echo "added Karatasi to $CONF"
fi

hyprctl reload >/dev/null
if ! pgrep -x karatasi >/dev/null; then
  setsid uwsm-app -- karatasi start >/dev/null 2>&1 &
fi
echo "Karatasi is running. Press Super+N to open your notes."
